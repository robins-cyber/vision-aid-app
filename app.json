{
  "expo": {
    "name": "Vision Aid",
    "slug": "vision-aid",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.visionaid.objectdetector",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Vision Aid needs camera access to detect objects."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0e448f7f-1f56-4dba-bc4c-fb4d16087a37"
      }
    },
    "owner": "rob01"
  }
}
